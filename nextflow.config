manifest.nextflowVersion = '>=25.10.2'
params {
    mode = 'analysis'
    samples = null
    input_root = null
    antibodies = 1200
    seed = 20261110
    read_seed = 2468
    memory_fraction = 0.5
    mutation_rate = 0.01
    protein_concentration = 'equal'
    pairs_per_chain = 100
    gradient_seconds = 1200
    stage_timeout = 900
    arda_overlay = "${projectDir}/.tool-envs/arda-overlay-read-map/overlay"
    repertoire = null
    panel = null
    references = null
    additional_references = null
    producer = 'supplied annotated export'
    physical_scope = 'all'
    ms2_per_bin = 5
    outdir = 'results/workflow'
    python = "${projectDir}/.venv/bin/python"
    cpus = Runtime.runtime.availableProcessors()
    analysis_executor = null
    analysis_task_cpus = 1
    analysis_task_memory = '4 GB'
    analysis_memory_budget = '16 GB'
    analysis_task_time = '30 min'
    analysis_partition = 'short'
}
process {
    executor = 'local'
    cpus = { Math.min(params.cpus as int, (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int) }
    memory = '4 GB'
    time = '15 min'
    maxForks = 1
    withName: REAL_COHORT {
        cpus = { params.mode in ['joint','joint-airr'] ? 2 : Math.min(params.cpus as int, (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int) }
        memory = { params.mode == 'joint-airr' ? '7 GB' : params.mode == 'joint' ? '8 GB' : '16 GB' }
    }
    withName: SIMULATE_AIRR {
        cpus = { params.mode == 'joint-airr' ? Math.min(params.cpus as int, (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int) - 2 : Math.min(params.cpus as int, (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int) }
        memory = { params.mode == 'joint-airr' ? '8 GB' : '16 GB' }
    }
    withName: POPULATION {
        cpus = { params.mode == 'joint' ? Math.min(params.cpus as int, (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int) - 2 : Math.min(params.cpus as int, (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int) }
        memory = { params.mode == 'joint' ? '7 GB' : '16 GB' }
    }
    cache = false
}
workDir = 'tmp/nextflow-work'
profiles {
    analysis_node {
        params.analysis_executor = 'local'
        includeConfig 'workflows/analysis_resources.config'
    }
    analysis_slurm {
        params.analysis_executor = 'slurm'
        includeConfig 'workflows/analysis_resources.config'
    }
    reproduction {
        process.memory = '16 GB'
        process.time = '30 min'
        executor.memory = '16 GB'
    }
}
// The orchestration JVM may use fewer helper cores than the scientific task.
executor.cpus = Math.min(params.cpus as int, (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int)
