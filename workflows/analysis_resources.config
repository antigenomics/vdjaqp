// Observed analysis only. The declared Slurm budget belongs to submitted tasks,
// independently of the launcher's SLURM_CPUS_PER_TASK.
def requested = Math.max(1, params.cpus as int)
def budget = params.analysis_executor == 'slurm' ? requested : Math.min(requested,
    (System.getenv('SLURM_CPUS_PER_TASK') ?: Runtime.runtime.availableProcessors()) as int)
def taskCpus = Math.min(Math.max(1, params.analysis_task_cpus as int), budget)
def taskMemory = nextflow.util.MemoryUnit.of(params.analysis_task_memory)
def memoryBudget = nextflow.util.MemoryUnit.of(params.analysis_memory_budget)
def forks = Math.max(1, Math.min(budget.intdiv(taskCpus),
    (memoryBudget.toBytes() / taskMemory.toBytes()) as int))
process {
    withName: ANALYSE {
        executor = params.analysis_executor
        cpus = taskCpus
        memory = taskMemory
        time = params.analysis_task_time
        maxForks = forks
        queue = params.analysis_executor == 'slurm' ? params.analysis_partition : null
        beforeScript = "export OMP_NUM_THREADS=${taskCpus} OPENBLAS_NUM_THREADS=1 MKL_NUM_THREADS=1 POLARS_MAX_THREADS=${taskCpus}"
    }
}
executor {
    cpus = budget
    memory = memoryBudget
    queueSize = forks
}
