@@ -0,0 +1,36 @@
+"""Raw and gzip AIRR inputs must give identical existing QC rows."""
+import gzip
+import polars as pl
+import pytest
+from arda import stats
+
+
+@pytest.mark.parametrize('optional',[False,True])
+@pytest.mark.parametrize('header_only',[False,True])
+def test_stats_rows_and_projected_fields_equal_raw_gzip(tmp_path,monkeypatch,optional,header_only):
+    # No reference lookup: this is input-format equivalence, not scientific QC.
+    monkeypatch.setattr(stats,'_gene_universe',lambda organism:{})
+    columns=['sequence_id','locus','v_call','j_call','junction','junction_aa','unused_wide']
+    values=['r1','IGH','IGHV1-2*01','IGHJ4*01','TGTGCTTGG','CAW','X'*1000]
+    if optional:
+        columns+=['junction_quality','v_mutations','v_mutation_quality','v_identity']
+        values+=['I"IIIIIII','','','']
+    text='\t'.join(columns)+'\n'
+    if not header_only:text+='\t'.join(values)+'\n'
+    raw=tmp_path/'native.airr.tsv';raw.write_text(text)
+    packed=tmp_path/'native.airr.tsv.gz'
+    with packed.open('wb') as handle:
+        with gzip.GzipFile(filename='',fileobj=handle,mode='wb',mtime=0) as stream:stream.write(raw.read_bytes())
+    a=stats._read_present(raw,stats._READ_COLS);b=stats._read_present(packed,stats._READ_COLS)
+    assert a.equals(b) and 'unused_wide' not in b.columns
+    assert all(dtype==pl.String for dtype in b.schema.values())
+    assert ('junction_quality' in b.columns)==optional
+    if optional and not header_only:assert b['junction_quality'][0]=='I"IIIIIII'
+    assert stats.collect(airr=raw)==stats.collect(airr=packed)
+
+
+def test_absent_requested_fields_remain_empty_for_both_formats(tmp_path):
+    raw=tmp_path/'unrelated.tsv';raw.write_text('unused\nvalue\n')
+    packed=tmp_path/'unrelated.tsv.gz'
+    with gzip.GzipFile(filename='',fileobj=packed.open('wb'),mode='wb',mtime=0) as stream:stream.write(raw.read_bytes())
+    for path in [raw,packed]:assert stats._read_present(path,stats._READ_COLS).shape==(0,0)
