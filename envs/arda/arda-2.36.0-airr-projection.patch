index 0000000..36e84ef
--- /dev/null
+++ b/tests/unit/test_correct_projection.py
@@ -0,0 +1,71 @@
+"""Constructed correction equivalence: projected AIRR reads versus full-reader baseline."""
+from pathlib import Path
+
+import polars as pl
+import pytest
+
+from arda.annotate.airr_out import read_airr
+from arda.rnaseq import correct
+
+COLUMNS={'sequence_id','sequence','rev_comp','locus','v_call','j_call','c_call',
+         'c_class','junction','junction_aa','junction_quality'}
+PARENT='TGTGCCAGCAGCTTAGACGGGACAGGGTTC'
+FAR='TGTGCCAGCAGCTTAGACGGGTAAGCATTC'
+
+
+def source_rows():
+    rows=[]
+    for label,junction,n,q in [('p',PARENT,400,'I'),('far',FAR,2,'4'),
+                               ('gate',PARENT[:-4]+'TTTC',1,'!')]:
+        for i in range(n):
+            rows.append(dict(sequence_id=f'cell1_UMI{i:04d}_{label}/1',sequence=junction,
+                rev_comp='F',locus='TRB',v_call='TRBV20-1*01',j_call='TRBJ2-1*01',
+                c_call='TRBC1',c_class='TRBC',junction=junction,junction_aa='CASSLDGTGF',
+                junction_quality=q*len(junction),sequence_alignment='unused'*100,
+                germline_alignment='unused'*100,fwr1='ACGT',fwr1_aa='T',
+                v_mutations='A1C',v_mutation_quality='40'))
+    # An incomplete mate, a constant-only mate and an assembled rescue retain their roles.
+    rows.append({**rows[0],'sequence_id':'partial/1','sequence':PARENT[:24],
+                 'junction':PARENT[:24],'junction_aa':'CASSLDGT','junction_quality':'I'*24})
+    rows.append({**rows[0],'sequence_id':rows[0]['sequence_id'][:-1]+'2',
+                 'junction':'','junction_aa':'','junction_quality':''})
+    return rows
+
+
+@pytest.mark.parametrize('mode',sorted(correct.EC_MODES))
+@pytest.mark.parametrize('options',[{},dict(coverage=False,isotype=False,call_level='gene',clonotype_key='junction')])
+def test_projection_matches_full_reader_scientific_outputs(tmp_path,monkeypatch,mode,options):
+    main=tmp_path/'main.tsv';extra=tmp_path/'extra.tsv'
+    rows=source_rows();pl.DataFrame(rows).write_csv(main,separator='\t',quote_style='never')
+    pl.DataFrame([{**rows[0],'sequence_id':'partial/1'}]).write_csv(extra,separator='\t',quote_style='never')
+    results=[];requests=[]
+    for projected in (False,True):
+        def reader(path,*,columns=None):
+            if projected:
+                requests.append((Path(path).name,columns))
+                return read_airr(path,columns=columns)
+            return read_airr(path)
+        monkeypatch.setattr(correct,'_read_airr',reader)
+        out=tmp_path/f'{projected}.tsv';mapping=tmp_path/f'{projected}.map.tsv'
+        report=correct.correct_airr(main,out,extra_airr=extra,ec_mode=mode,
+            read_map=mapping,**options).as_dict()
+        for field in ('wall_seconds','peak_rss_mb','rss_gain_mb'):report.pop(field)
+        results.append((out.read_bytes(),mapping.read_bytes(),report))
+    assert results[0]==results[1]
+    assert len(requests)==2 and all(set(cols)==COLUMNS for _,cols in requests)
+    assert results[1][2]['reads_from_assembly']==1
+    if mode in ('amplicon','rnaseq'):
+        assert results[1][2]['rescued_reads']>0
+
+
+@pytest.mark.parametrize('mode',['amplicon','rnaseq'])
+def test_missing_quality_error_is_preserved(tmp_path,monkeypatch,mode):
+    path=tmp_path/'missing.tsv'
+    pl.DataFrame(source_rows()).drop('junction_quality').write_csv(path,separator='\t')
+    errors=[]
+    for projected in (False,True):
+        monkeypatch.setattr(correct,'_read_airr',lambda p,columns=None:read_airr(p,**({'columns':columns}if projected else {})))
+        with pytest.raises(ValueError) as error:
+            correct.correct_airr(path,tmp_path/f'{projected}.tsv',ec_mode=mode)
+        errors.append(str(error.value))
+    assert errors[0]==errors[1] and 'junction_quality' in errors[0]
