@@ -0,0 +1,75 @@
+"""Column pushdown preserves v2.36 AIRR values and assembly decisions."""
+import gzip
+import random
+
+import polars as pl
+import pytest
+from arda.annotate.airr_out import read_airr
+
+
+@pytest.mark.parametrize('compressed',[False,True])
+@pytest.mark.parametrize('header_only',[False,True])
+def test_projection_matches_full_reader_present_fields_and_order(tmp_path,compressed,header_only):
+    text='sequence_id\tunused\tjunction\tjunction_quality\tmissing_value\n'
+    if not header_only:text+='r2\tWIDE\tacgn\t!"#\t""\nr1\tOTHER\tTGT\tIII\t\n'
+    path=tmp_path/('input.tsv.gz' if compressed else 'input.tsv')
+    if compressed:
+        with gzip.open(path,'wt') as stream:stream.write(text)
+    else:path.write_text(text)
+    full=read_airr(path)
+    projected=read_airr(path,columns=['junction_quality','missing_value','absent','sequence_id','junction'])
+    expected=full.select([c for c in full.columns if c!='unused'])
+    assert projected.equals(expected)
+    assert 'absent' not in projected.columns
+    assert all(dtype==pl.String for dtype in projected.schema.values())
+    if not header_only:
+        assert projected['sequence_id'].to_list()==['r2','r1']
+        assert projected['junction_quality'].to_list()==['!"#','III']
+        assert projected['junction'][0]=='acgn'  # v2.36 behavior, no new normalization.
+        assert projected['missing_value'].to_list()==['',None]
+
+
+def test_payload_reader_receives_projection_and_missing_quality_stays_absent(tmp_path,monkeypatch):
+    from arda.annotate import airr_out
+    path=tmp_path/'native.tsv';path.write_text('sequence_id\tsequence\tunused_wide\nr1\tACT\t'+('X'*10000)+'\n')
+    native=airr_out.pl.read_csv;calls=[]
+    def spy(*args,**kwargs):
+        calls.append(kwargs.copy());return native(*args,**kwargs)
+    monkeypatch.setattr(airr_out.pl,'read_csv',spy)
+    out=airr_out.read_airr(path,columns=['sequence_id','sequence','junction_quality'])
+    assert calls==[dict(separator='\t',infer_schema_length=0,quote_char=None,columns=['sequence_id','sequence'])]
+    assert out.columns==['sequence_id','sequence'] and 'junction_quality' not in out.columns
+    assert airr_out.read_airr(path,columns=['absent']).shape==(0,0)
+    assert len(calls)==1  # No payload read when no requested field exists.
+
+
+def test_assembly_output_and_counts_equal_original_full_reader(tmp_path,monkeypatch):
+    import arda.rnaseq.assemble as asm
+    from arda.annotate.airr_out import read_airr as projected_read
+    rng=random.Random(3)
+    junction='TGT'+'GCTAGA'*12+'TGG';junction_aa='C'+'AR'*12+'W'
+    molecule=''.join(rng.choice('ACGT') for _ in range(120))+junction+''.join(rng.choice('ACGT') for _ in range(60))
+    rows=[]
+    for i,offset in enumerate([0,30,60,90,120,150,180]):
+        cs=120-offset
+        rows.append(dict(sequence_id=f'f{i}/1',sequence=molecule[offset:offset+100],rev_comp='F',locus='IGH',
+            v_call='IGHV3-23*01',j_call='IGHJ4*02',c_call='',c_class='',cdr3_start=str(cs) if 0<=cs<100 else '',
+            junction='',junction_aa='',unused_wide='X'*10000))
+    path=tmp_path/'mapped.tsv';pl.DataFrame(rows).write_csv(path,separator='\t')
+    def annotate(records,*args,**kwargs):
+        return [dict(sequence_id=name,junction=junction,junction_aa=junction_aa,
+            v_call='IGHV3-23*01',j_call='IGHJ4*02',locus='IGH') for name,_ in records]
+    monkeypatch.setattr(asm,'reannotate_contigs',annotate)
+    baseline=tmp_path/'full.tsv';fresh=tmp_path/'projected.tsv'
+    monkeypatch.setattr(asm,'_read_airr',lambda path,**kwargs:projected_read(path))
+    old=asm.assemble_contigs(path,baseline)
+    observed=[]
+    def narrow(path,**kwargs):
+        observed.append(kwargs['columns']);return projected_read(path,**kwargs)
+    monkeypatch.setattr(asm,'_read_airr',narrow)
+    new=asm.assemble_contigs(path,fresh)
+    assert baseline.read_bytes()==fresh.read_bytes()
+    assert old.reads_rescued==new.reads_rescued>0
+    for key,value in old.as_dict().items():
+        if key not in ['wall_seconds','peak_rss_mb','rss_gain_mb']:assert new.as_dict()[key]==value
+    assert len(observed)==1 and len(observed[0])==11 and 'unused_wide' not in observed[0]
